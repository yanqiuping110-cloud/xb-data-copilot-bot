# Opensource / AI-agent demo defaults (Scheme A). No cloud API key required.
APP_ENV=demo
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173

JWT_SECRET=demo-jwt-secret-change-me-in-prod-32b
JWT_EXPIRE_HOURS=72
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=demo123456

LLM_MODE=fixture
LLM_API_BASE=http://127.0.0.1:11434/v1
LLM_API_KEY=fixture
LLM_MODEL=fixture-demo
LLM_TIMEOUT_SEC=30

EMBEDDING_API_BASE=http://127.0.0.1:11434/v1
EMBEDDING_API_KEY=fixture
EMBEDDING_MODEL=fixture
EMBEDDING_DIMS=64

MYSQL_COPILOT_HOST=mysql
MYSQL_COPILOT_PORT=3306
MYSQL_COPILOT_USER=copilot
MYSQL_COPILOT_PASSWORD=demo_copilot
MYSQL_COPILOT_DATABASE=copilot

# Fallback only — demo bootstrap registers excel as default business DS
MYSQL_BUSINESS_HOST=mysql
MYSQL_BUSINESS_PORT=3306
MYSQL_BUSINESS_USER=copilot
MYSQL_BUSINESS_PASSWORD=demo_copilot
MYSQL_BUSINESS_DATABASE=copilot

VECTOR_STORE=zvec
ZVEC_DATA_DIR=data/zvec
POLICY_SCH_ID_ENABLED=false
SQL_MAX_ROWS=100

DEMO_PROFILE=excel
