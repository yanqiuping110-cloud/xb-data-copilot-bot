# 在 backend/ 目录下复制为 .env.development 或 .env.production，勿提交含密码的文件
# 启动前（PowerShell）: cd backend; $env:APP_ENV="development"

# ---------- 运行环境 ----------
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- LLM（OpenAI 兼容，本机 Ollama）----------
# openai=真实模型；fixture=开源 Demo 预置问句（无需 Key）
LLM_MODE=openai
# 运行时优先读管理台写入的 copilot_llm_model / copilot_business_datasource；
# 以下 LLM_* / EMBEDDING_* / MYSQL_BUSINESS_* 用于冷启动种子与库不可用时回退。
LLM_API_BASE=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5-coder:7b
LLM_TIMEOUT_SEC=120
# DeepSeek 思考模式（需 LLM_API_BASE=https://api.deepseek.com）
LLM_THINKING_ENABLED=false
LLM_THINKING_STREAM=true
LLM_THINKING_STREAM_ADMIN_ONLY=true
LLM_REASONING_EFFORT=high

# ---------- Embedding（Ollama，检索/RAG 用）----------
EMBEDDING_API_BASE=http://127.0.0.1:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=qwen3-embedding:4b

# ---------- MySQL 5.7（宿主机/公司，非 Docker）----------
# 业务库：账号建议仅 GRANT SELECT；应用禁止 DML/DDL（见 docs/DATABASE_CHANGE_POLICY.md）
MYSQL_BUSINESS_HOST=127.0.0.1
MYSQL_BUSINESS_PORT=3306
MYSQL_BUSINESS_USER=ask_readonly
MYSQL_BUSINESS_PASSWORD=
MYSQL_BUSINESS_DATABASE=sport

MYSQL_COPILOT_HOST=127.0.0.1
MYSQL_COPILOT_PORT=3306
MYSQL_COPILOT_USER=copilot
MYSQL_COPILOT_PASSWORD=
MYSQL_COPILOT_DATABASE=copilot
# 问数库：应用允许 DML；表结构变更仅 scripts/sql/copilot/V*.sql 人工执行
# 系统配置密文：可选；不配则用 JWT_SECRET 派生 Fernet 密钥（见 docs/LLM_DATASOURCE_CONFIG_PLAN.md）
# CONFIG_CRYPTO_KEY=

# ---------- JWT / 超管种子 ----------
JWT_SECRET=change-me-use-long-random-string-min-32-chars
JWT_EXPIRE_HOURS=24
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=123456

# ---------- SQL 安全 ----------
SQL_DIALECT=mysql
SQL_MAX_ROWS=5000
SQL_TIMEOUT_SEC=10
ASK_RATE_LIMIT_PER_USER_PER_MIN=20

# ---------- Git 代码知识（GitLab Personal Access Token · read_repository）----------
# 后台 Git 仓库「凭证 env」填 GIT_TOKEN；http/https 均支持
GIT_TOKEN=

# ---------- 问数检索（默认 Zvec 进程内；ES 保留供 RAGFlow / VECTOR_STORE=elasticsearch）----------
VECTOR_STORE=zvec
ZVEC_DATA_DIR=data/zvec
ZVEC_INDEX_PREFIX=copilot_ask_
RECALL_HYBRID_RERANK=true
RECALL_RERANK_FETCH_MULTIPLIER=3
RECALL_RRF_RANK_CONSTANT=60

# RAGFlow 栈（Docker Desktop · RAGFlow 自带 compose）
# es01 → 宿主机 1200（容器内 9200）· redis 6379 · minio 9000 · ragflow https://127.0.0.1:443
RAGFLOW_ENABLED=false
RAGFLOW_BASE_URL=https://127.0.0.1
ELASTICSEARCH_URL=http://elastic:infini_rag_flow@127.0.0.1:1200
ELASTICSEARCH_INDEX_PREFIX=copilot_ask_
EMBEDDING_DIMS=2560
RECALL_TOP_K_TABLE=8
RECALL_TOP_K_COLUMN=5
RECALL_TOP_K_METRIC=5
RECALL_TOP_K_VALUE=5
MAX_TABLES_IN_PROMPT=8
MAX_COLUMNS_PER_TABLE=15
TABLE_RECALL_SCORE_MIN=0.7
RECALL_KEYWORD_FALLBACK=true
# 字段向量/关键词召回；false 时跳过 do_recall_columns，Prompt 字段仅来自元数据 filter_columns
RECALL_COLUMNS_ENABLED=false

# L1 样例软参考（注入 LLM Prompt，不再硬命中跳过生成）
# L1 样例：知识库召回 + LLM 精选（匹配规则 JSON / 优先级已弃用）
L1_RECALL_TOP_K=10
L1_SELECT_MAX=3
L1_SELECT_LLM_ENABLED=true
L1_SELECT_CONTEXT_MAX_CHARS=6000

# ---------- Agent Memory（第 6 周）----------
MEMORY_ENABLED=true
SESSION_MEMORY_ENABLED=true
MEMORY_LLM_ENABLED=true
USER_PREFERENCE_ENABLED=true
MEMORY_PROMPT_MAX_CHARS=2000
SESSION_MEMORY_MAX_TURNS=3
SESSION_MAX_PER_USER=20
SESSION_EVICT_POLICY=oldest
SESSION_UI_TURN_LIMIT=30

# ---------- Agent Plan + 多步 SQL（§11.7）----------
# AGENT_MULTI_SQL_ENABLED=true 时复杂问句按 plan 分步执行 SQL 并 assemble_result 拼表
# AGENT_MULTI_SQL_ENABLED=false 时仍走单条 CTE generate_sql_step
MINIO_ENDPOINT=http://127.0.0.1:9000

# ---------- 动态数据权限（第 13 周 · §11.6）----------
POLICY_DATA_SCOPE_ENABLED=false
POLICY_DEFAULT_DENY=true
POLICY_CACHE_TTL_SEC=60

# ---------- Prompt Injection 防护（第 13 周 · §11.9）----------
PROMPT_BOUNDARY_ENABLED=true
PROMPT_SANITIZE_RECALL_ENABLED=true
PROMPT_INJECTION_LOG_ENABLED=true

# ---------- Insight Engine · 深度分析报告（DAR）----------
RESEARCH_ENABLED=true
RESEARCH_MAX_SECTIONS=12
RESEARCH_TARGET_PAGES=30
RESEARCH_MAX_PAGES=80
RESEARCH_SECTION_TIMEOUT_SEC=90
RESEARCH_TOTAL_TIMEOUT_SEC=300
RESEARCH_MAX_CONCURRENT=1
RESEARCH_EXPORT_PDF=true
RESEARCH_PDF_THEME=default
RESEARCH_STORAGE_DIR=storage/reports
RESEARCH_PDF_URL_PREFIX=/api/v1/research/report
RESEARCH_DEMO_PACE=normal
RESEARCH_HEARTBEAT_INTERVAL_SEC=2
RESEARCH_STREAM_TEXT_DELTA=true
RESEARCH_KEEP_HTML_DEBUG=false
RESEARCH_LLM_PLANNER_ENABLED=true
RESEARCH_SYNTHESIZER_LLM_ENABLED=true
RESEARCH_PDF_ENGINE=auto

# ---------- Phase 2 · Chart PNG（问数页用前端 ECharts；此处仅 PDF 导出等服务端渲染）----------
CHART_SSR_ENABLED=false
CHART_SSR_URL=http://127.0.0.1:3001
CHART_SSR_TIMEOUT_MS=5000
CHART_SSR_WIDTH=720
CHART_SSR_HEIGHT=400
CHART_SSR_API_KEY=
CHART_STORAGE_DIR=storage/charts

# ---------- Phase 2 · 术语库 ----------
GLOSSARY_RECALL_ENABLED=true
GLOSSARY_RECALL_TOP_K=5

# ---------- 问数 · 报告分析（Brief Report）----------
BRIEF_REPORT_ENABLED=false
BRIEF_REPORT_STORAGE_DIR=storage/brief-reports
BRIEF_REPORT_BACKGROUNDS_DIR=app/brief_report/assets/backgrounds
BRIEF_REPORT_THEME=presentation
BRIEF_REPORT_PAGE_LAYOUT=a4-portrait
BRIEF_REPORT_MAX_CHAPTERS=12
BRIEF_REPORT_LLM_ENABLED=true
BRIEF_REPORT_PDF_ENGINE=auto
BRIEF_REPORT_TABLE_MAX_ROWS=15
BRIEF_REPORT_PDF_URL_PREFIX=/api/v1/ask/brief-report

EMBED_ENABLED=false
EMBED_ALLOWED_ORIGINS=http://localhost:5173
EMBED_TOKEN_TTL_SEC=3600
EMBED_APP_ID=
EMBED_APP_SECRET=
EMBED_FRAME_ANCESTORS='self'
MCP_ENABLED=false
MCP_API_KEY=
MCP_API_BASE=http://127.0.0.1:8000
